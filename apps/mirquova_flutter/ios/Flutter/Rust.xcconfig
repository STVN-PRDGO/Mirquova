// Build the matching static library with scripts/Build-iOS.sh before Xcode.
MIRQUOVA_RUST_TARGET = aarch64-apple-ios
MIRQUOVA_RUST_TARGET[sdk=iphonesimulator*] = aarch64-apple-ios-sim
ARCHS = arm64
// Keep the statically linked ABI in the executable in debug builds too.
ENABLE_DEBUG_DYLIB = NO
CODE_SIGN_ENTITLEMENTS = Runner/Runner.entitlements
OTHER_LDFLAGS = $(inherited) -force_load "$(SRCROOT)/../../../target/$(MIRQUOVA_RUST_TARGET)/release/libmirquova_core.a" -Wl,-export_dynamic -Wl,-u,_mq_abi_version -Wl,-u,_mq_discovery_start -Wl,-u,_mq_discovery_stop -Wl,-u,_mq_discovery_snapshot -Wl,-u,_mq_string_free -Wl,-u,_mq_presence_start -Wl,-u,_mq_presence_stop -Wl,-u,_mq_pairing_identity_create -Wl,-u,_mq_pairing_identity_free -Wl,-u,_mq_pairing_identity_validate -Wl,-u,_mq_pairing_host_start -Wl,-u,_mq_pairing_join -Wl,-u,_mq_pairing_approve -Wl,-u,_mq_pairing_reject -Wl,-u,_mq_pairing_snapshot -Wl,-u,_mq_pairing_stop -framework SystemConfiguration -framework Security -framework Foundation -liconv -lresolv
